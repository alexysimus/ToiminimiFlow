# ==============================================================================
# Toiminimi Flow - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# NOTE: Toiminimi Flow works 100% locally out of the box in Tier 1 (Guest Mode)
# with zero environment variables configured. All entries below are optional
# placeholders for future Tier 2 features, custom domains, and personal branding.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Community Branding
# ------------------------------------------------------------------------------
# Used in the About section, footer, and open-source credits
VITE_APP_NAME="Toiminimi Flow"
VITE_APP_URL="https://toiminimiflow.fi"
VITE_AUTHOR_NAME="Alex & Open Source Contributors"
VITE_GITHUB_REPO_URL="https://github.com/alexysimus/ToiminimiFlow"
VITE_KOFI_URL="https://ko-fi.com/daocongthanh"
VITE_SUPPORT_EMAIL="support@toiminimiflow.fi"

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Optional Tier 2 Cloud Sync & Native Auth)
# ------------------------------------------------------------------------------
# Public identifiers for Firebase Auth (Google & Apple Sign-In) and Firestore.
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps.
# IMPORTANT: Sensitive secrets (e.g. Apple .p8 keys) are configured directly in
# the Firebase Console and MUST NEVER be placed in environment variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 3. Cookieless / Privacy-Preserving Analytics (Optional & GDPR-Compliant)
# ------------------------------------------------------------------------------
# If left empty, analytics remains completely disabled (zero network requests).
# When configured with Google Consent Mode v2 or cookieless trackers, all storage
# is denied by default so NO cookie consent banner is legally required under GDPR.
VITE_GA_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Optional Tier 2 Receipt Scanner)
# ------------------------------------------------------------------------------
# Used for optical character recognition (OCR) and expense categorization.
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=""
