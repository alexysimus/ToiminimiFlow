# Environment Variables Template
# Copy this file to .env.local to configure local settings
# Note: In Tier 1 (Guest Mode), no API key is required. All core features work locally out of the box.

# Optional: Google Gemini API Key (For future Tier 2 registered user receipt analysis)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
